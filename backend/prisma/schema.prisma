  calificacionRubrica CalificacionRubrica?
  sesionesEdicion     SesionEdicionTarea[]

  turnosExposicion TurnoExposicion[]

  @@unique([tareaId, estudianteId])
  @@unique([tareaId, grupoCursoId])
  @@unique([tareaId, equipoAfinidadTareaId])
  @@index([tareaId])
  @@index([autorEntregaId])
  @@index([estudianteId])
  @@index([grupoCursoId])
  @@index([equipoAfinidadTareaId])
  @@index([estado])
  @@index([entregadaTarde])
  @@index([estaActiva])
  @@index([enviadaEn])
  @@index([tareaId, estado, estaActiva])
}

model SesionEdicionTarea {
