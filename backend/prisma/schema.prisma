  TAREA
  TAREA_ENTREGA
  DOCUMENTO
  REPORTE
  OTRO
}

/**
 * Define si un recurso académico está disponible durante todo el curso
 * o únicamente dentro de un hito determinado.
 */
/**
 * Define la naturaleza del recurso académico.
 * ARCHIVO utiliza ArchivoAdjunto y permite historial de versiones.
 * ENLACE almacena una URL externa y no genera versiones.
 */
enum TipoContenidoRecurso {
  ARCHIVO
  ENLACE
}

enum CategoriaRecursoCurso {
  NORMATIVA
  JURISPRUDENCIA
  DOCTRINA
  GUIA_ACADEMICA
  CASO_PRACTICO
  MODELO_JURIDICO
  MATERIAL_AUDIOVISUAL
  MATERIAL_COMPLEMENTARIO
  OTRO
}

enum AlcanceRecursoCurso {
  CURSO
  HITO
}

/**
 * Define el propósito funcional del recurso dentro de IusAcademy.
 * AULA:
 * Material académico utilizado únicamente dentro del aula.
 * AULA_Y_QUIZZES:
 * Material académico que puede mostrarse en el aula y cuyos PDF
 * seleccionados pueden reutilizarse como fuentes para Quizzes.
 * SOLO_QUIZZES:
 * Recurso privado del docente utilizado únicamente como fuente
 * para Quizzes. No debe mostrarse a estudiantes.
 */
enum UsoRecursoCurso {
  AULA
  AULA_Y_QUIZZES
  SOLO_QUIZZES
}

enum EstadoRecursoCurso {
  ACTIVO
  ARCHIVADO
}

