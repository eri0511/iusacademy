   * false = permanece oculto hasta la fecha de apertura.
   */
  visibleAntesDeApertura Boolean @default(true)

  /**
   * Compatibilidad temporal con la versión anterior del Foro.
   * Más adelante puede eliminarse cuando todo el backend use fechaLimite.
   */
  fechaVencimiento DateTime?

  permitirRetrasos Boolean @default(false)

  fechaMaximaRetraso DateTime?

  tipoDescuentoRetraso  TipoDescuentoRetraso @default(NINGUNO)
  valorDescuentoRetraso Decimal?             @db.Decimal(6, 2)

  visibilidadRespuestas VisibilidadRespuestasForo @default(DESDE_EL_INICIO)

  permitirAdjuntosTema       Boolean @default(true)
  permitirAdjuntosRespuesta  Boolean @default(false)
  permitirAdjuntosComentario Boolean @default(false)
  exigirAdjuntoRespuesta     Boolean @default(false)
  permitirDescargaAdjuntos   Boolean @default(true)

  maximoArchivosTema       Int @default(5)
  maximoArchivosRespuesta  Int @default(3)
  maximoArchivosComentario Int @default(1)

  tamanioMaximoArchivoMb Int @default(10)

  extensionesPermitidas String[] @default(["pdf", "doc", "docx", "jpg", "jpeg", "png", "webp"])

  estado EstadoForo @default(BORRADOR)

  estaFijado  Boolean @default(false)
  estaCerrado Boolean @default(false)
  estaActivo  Boolean @default(true)

