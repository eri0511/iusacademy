/**
 * Componente institucional dentro de cada hito.
 * CONTINUA:
 * El promedio de sus actividades se convierte al
 * puntajeContinua configurado en HitoAcademico
 * (actualmente 15 puntos).
 * PROCESUAL:
 * El promedio de sus actividades se convierte al
 * puntajeProcesual configurado en HitoAcademico
 * (actualmente 10 puntos).
 */
enum ComponenteEvaluacion {
  CONTINUA
  PROCESUAL
}

