enum TratamientoUsuario {
  DR
  DRA
}

model Usuario {
  bibliotecaRecursos          RecursoBiblioteca[]          @relation("BibliotecaAutor")
  bibliotecaVersiones         VersionContenidoBiblioteca[] @relation("BibliotecaVersionAutor")
  bibliotecaPermiso           PermisoGestionBiblioteca?    @relation("BibliotecaDocentePermiso")
  bibliotecaPermisosOtorgados PermisoGestionBiblioteca[]   @relation("BibliotecaOtorgaPermiso")
  bibliotecaPermisosRevocados PermisoGestionBiblioteca[]   @relation("BibliotecaRevocaPermiso")
  bibliotecaFavoritos         FavoritoBiblioteca[]
  bibliotecaColecciones       ColeccionBiblioteca[]
  bibliotecaReportes          ReporteRecursoBiblioteca[]   @relation("BibliotecaReportante")
  bibliotecaReportesAtendidos ReporteRecursoBiblioteca[]   @relation("BibliotecaAtiendeReporte")
  bibliotecaHistorial         HistorialBiblioteca[]

  id Int @id @default(autoincrement())

  nombres         String
  apellidoPaterno String
  apellidoMaterno String?
  tratamiento TratamientoUsuario?

  correo       String  @unique
  passwordHash String?

  fotoPerfilUrl String?

  rol            Rol
  estaActivo     Boolean @default(true)
  cuentaActivada Boolean @default(false)

  tokenActivacionHash   String?
  tokenActivacionExpira DateTime?
  accesoEnviadoEn       DateTime?

  passwordCambiadaEn DateTime?
  ultimoAccesoEn     DateTime?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  cursosComoDocente Curso[] @relation("CursosDocente")

  inscripcionesComoEstudiante InscripcionCurso[] @relation("InscripcionesEstudiante")

  publicacionesComoAutor PublicacionCurso[] @relation("PublicacionesAutor")

  comentariosComoAutor ComentarioPublicacion[] @relation("ComentariosAutor")

  lecturasPublicaciones LecturaPublicacion[] @relation("LecturasUsuario")

  lecturasTemasForo LecturaTemaForo[] @relation("LecturasTemasForoUsuario")

  temasForoComoAutor TemaForoCurso[] @relation("TemasForoAutor")

  tareasComoAutor TareaCurso[] @relation("TareasAutor")

  recursosCursoComoAutor RecursoCurso[] @relation("RecursosCursoAutor")

  entregasTareaComoAutor    EntregaTarea[] @relation("EntregasTareaAutor")
  entregasTareaIndividuales EntregaTarea[] @relation("EntregasTareaEstudiante")

  sesionesEdicionTarea SesionEdicionTarea[]

  equiposAfinidadTareaComoCreador EquipoAfinidadTarea[]   @relation("EquiposAfinidadTareaCreador")
  integrantesEquiposTarea         IntegranteEquipoTarea[] @relation("IntegrantesEquipoTareaEstudiante")

  respuestasForoComoAutor RespuestaForoCurso[] @relation("RespuestasForoAutor")

  comentariosRespuestasForoComoAutor ComentarioRespuestaForo[] @relation("ComentariosRespuestasForoAutor")

  equiposForoComoCreador EquipoAfinidadForo[] @relation("EquiposForoCreador")

  integrantesEquiposForo IntegranteEquipoForo[] @relation("IntegrantesEquipoForoEstudiante")

  archivosSubidos ArchivoAdjunto[] @relation("ArchivosSubidosPor")

  actividadesCalificablesCreadas ActividadCalificable[] @relation("ActividadesCalificablesCreador")

  calificacionesComoEstudiante CalificacionEstudiante[] @relation("CalificacionesEstudiante")

  calificacionesRegistradas CalificacionEstudiante[] @relation("CalificacionesCalificador")

  rubricasCreadas RubricaEvaluacion[] @relation("RubricasCreador")

  historialesForoComoActor HistorialForoCurso[] @relation("HistorialForoActor")

  historialesCalificacionComoActor HistorialCalificacion[] @relation("HistorialCalificacionActor")

  integrantesGrupos IntegranteGrupoCurso[] @relation("IntegrantesGrupoEstudiante")

  historialesGrupoComoActor HistorialGrupoCurso[] @relation("HistorialGrupoActor")

  historialesGrupoComoEstudiante HistorialGrupoCurso[] @relation("HistorialGrupoEstudiante")

  reportesGenerados ReporteEmitido[] @relation("ReportesGenerados")

  reportesAnulados ReporteEmitido[] @relation("ReportesAnulados")

  quizzesComoCreador QuizCurso[] @relation("QuizzesCreador")

  participacionesQuiz ParticipanteQuiz[] @relation("ParticipantesQuizEstudiante")

  intentosQuiz IntentoQuiz[] @relation("IntentosQuizEstudiante")

  notificacionesRecibidas Notificacion[] @relation("NotificacionesDestinatario")

  extensionesPlazoAutorizadas ExtensionPlazoTarea[] @relation("ExtensionesPlazoAutorizadas")

  extensionesPlazoBeneficiario ExtensionPlazoBeneficiario[] @relation("ExtensionesPlazoBeneficiario")

  jornadasExposicionCreadas JornadaExposicion[] @relation("JornadasExposicionCreador")

  preguntasExposicion PreguntaExposicion[] @relation("PreguntasExposicionAutor")

  votosPreguntaExposicion VotoPreguntaExposicion[] @relation("VotosPreguntaExposicionUsuario")

  turnosExposicionPresentados TurnoExposicion[] @relation("TurnosExposicionPresentador")

  analisisExposicionGenerados AnalisisExposicion[] @relation("AnalisisExposicionGenerador")

  @@index([rol])
  @@index([estaActivo])
  @@index([cuentaActivada])
  @@index([ultimoAccesoEn])
}

model Materia {
  id Int @id @default(autoincrement())

  nombre      String
  codigo      String  @unique
  semestre    Int
  descripcion String?

  estado EstadoMateria @default(ACTIVA)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  cursos Curso[]

  @@index([estado])
  @@index([semestre])
}

model PlanificacionAcademica {
  id Int @id @default(autoincrement())

  gestion String @unique

  descripcion String?

  estaActiva Boolean @default(true)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  hitos HitoAcademico[]

  cursos Curso[]

  @@index([gestion])
  @@index([estaActiva])
}

model HitoAcademico {
  id Int @id @default(autoincrement())

  planificacionId Int

  numero Int
  codigo String
  nombre String

  descripcion String?

  fechaInicio DateTime
  fechaFin    DateTime

  puntajeTotal     Int @default(0)
  puntajeContinua  Int @default(0)
  puntajeProcesual Int @default(0)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  planificacion PlanificacionAcademica @relation(fields: [planificacionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  publicaciones PublicacionCurso[]

  temasForo TemaForoCurso[]

  tareas TareaCurso[]

  recursos RecursoCurso[]

  entregasTarea        EntregaTarea[]
  equiposAfinidadTarea EquipoAfinidadTarea[]

  conjuntosGrupos ConjuntoGrupoCurso[]

  actividadesCalificables ActividadCalificable[]

  quizzes QuizCurso[]

  @@unique([planificacionId, numero])
  @@unique([planificacionId, codigo])
  @@index([planificacionId])
  @@index([numero])
  @@index([codigo])
  @@index([fechaInicio])
  @@index([fechaFin])
  @@index([planificacionId, numero])
}

model Curso {
  id Int @id @default(autoincrement())

  materiaId Int
  docenteId Int

  planificacionId Int?

  gestion    String
  paralelo   String
  semestre   Int
  cupoMaximo Int?

  codigoInscripcion       String?   @unique
  codigoInscripcionActivo Boolean   @default(false)
  codigoGeneradoEn        DateTime?
  codigoExpiraEn          DateTime?

  estado       EstadoCurso @default(ACTIVO)
  finalizadoEn DateTime?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  materia Materia @relation(fields: [materiaId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  docente Usuario @relation("CursosDocente", fields: [docenteId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  planificacion PlanificacionAcademica? @relation(fields: [planificacionId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  inscripciones InscripcionCurso[]

  publicaciones PublicacionCurso[]

  temasForo TemaForoCurso[]

  tareas TareaCurso[]

  recursos RecursoCurso[]

  conjuntosGrupos ConjuntoGrupoCurso[]

  actividadesCalificables ActividadCalificable[]

  quizzes QuizCurso[]

  equiposAfinidadForo EquipoAfinidadForo[]

  archivosAdjuntos     ArchivoAdjunto[]
  equipoAfinidadTareas EquipoAfinidadTarea[]

  @@unique([materiaId, gestion, paralelo])
  @@index([materiaId])
  @@index([docenteId])
  @@index([planificacionId])
  @@index([gestion])
  @@index([semestre])
  @@index([estado])
  @@index([finalizadoEn])
}

model InscripcionCurso {
  id Int @id @default(autoincrement())

  cursoId      Int
  estudianteId Int

  estado EstadoInscripcion @default(ACTIVA)

  inscritoEn DateTime  @default(now())
  retiradoEn DateTime?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  curso Curso @relation(fields: [cursoId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  estudiante Usuario @relation("InscripcionesEstudiante", fields: [estudianteId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([cursoId, estudianteId])
  @@index([cursoId])
  @@index([estudianteId])
  @@index([estado])
}

model PublicacionCurso {
  id Int @id @default(autoincrement())

  cursoId Int
  autorId Int
  hitoId  Int?

  tipo      TipoPublicacionCurso @default(AVISO_GENERAL)
  prioridad PrioridadPublicacion @default(INFORMATIVA)

  titulo    String
  contenido String

  referencia String?
  lugar      String?
  enlace     String?

  fechaEventoInicio DateTime?
  fechaEventoFin    DateTime?

  estaFijada Boolean @default(false)
  estaActiva Boolean @default(true)

  comentariosHabilitados Boolean @default(false)

  visibleParaEstudiantes Boolean @default(true)

  notificarAlPublicar  Boolean @default(true)
  recordarUnDiaAntes   Boolean @default(false)
  recordarUnaHoraAntes Boolean @default(false)
  agregarAlCalendario  Boolean @default(false)

  publicadoEn DateTime  @default(now())
  editadoEn   DateTime?
  eliminadoEn DateTime?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  curso Curso @relation(fields: [cursoId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  autor Usuario @relation("PublicacionesAutor", fields: [autorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  hito HitoAcademico? @relation(fields: [hitoId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  comentarios ComentarioPublicacion[]

  lecturas LecturaPublicacion[]

  @@index([cursoId])
  @@index([autorId])
  @@index([hitoId])
  @@index([tipo])
  @@index([prioridad])
  @@index([estaFijada])
  @@index([estaActiva])
  @@index([visibleParaEstudiantes])
  @@index([fechaEventoInicio])
  @@index([fechaEventoFin])
  @@index([publicadoEn])
  @@index([cursoId, estaActiva, estaFijada])
  @@index([cursoId, hitoId, estaActiva])
  @@index([cursoId, hitoId, visibleParaEstudiantes, estaActiva])
  @@index([cursoId, hitoId, fechaEventoInicio])
  @@index([cursoId, hitoId, prioridad, estaActiva])
  @@index([cursoId, hitoId, tipo, estaActiva])
}

model ComentarioPublicacion {
  id Int @id @default(autoincrement())

  publicacionId Int
  autorId       Int

  contenido String

  estaActivo Boolean @default(true)

  publicadoEn DateTime  @default(now())
  editadoEn   DateTime?
  eliminadoEn DateTime?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  publicacion PublicacionCurso @relation(fields: [publicacionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

