  actualizadoEn DateTime @updatedAt

  tarea TareaCurso @relation(fields: [tareaId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  autorEntrega Usuario @relation("EntregasTareaAutor", fields: [autorEntregaId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  estudiante Usuario? @relation("EntregasTareaEstudiante", fields: [estudianteId], references: [id], onDelete: Cascade, onUpdate: Cascade)

