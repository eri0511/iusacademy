/**
 * Rúbrica de evaluación vinculada a una tarea. Puede definirse
 * manualmente o importarse desde un archivo Excel.
 */
model RubricaTarea {
  id      Int @id @default(autoincrement())
  tareaId Int @unique

  nombre String
  origen OrigenRubrica @default(MANUAL)

  /**
   * Suma de los pesos de los criterios. Normalmente 100.
   */
  ponderacionMax Decimal @default(100) @db.Decimal(6, 2)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  tarea     TareaCurso        @relation(fields: [tareaId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  criterios RubricaCriterio[]

  @@index([tareaId])
}

model RubricaCriterio {
  id        Int @id @default(autoincrement())
  rubricaId Int

  orden Int

  nombre      String
  descripcion String?

  /**
   * Peso del criterio sobre la escala de 100. La suma de todos
   * los pesos debe equivaler a RubricaTarea.ponderacionMax.
   */
  peso Decimal @default(0) @db.Decimal(6, 2)

  rubrica RubricaTarea @relation(fields: [rubricaId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  niveles RubricaNivel[]

  calificaciones CriterioCalificacionEntrega[]

  @@unique([rubricaId, orden])
  @@index([rubricaId])
}

model RubricaNivel {
  id Int @id @default(autoincrement())

  criterioId Int

  orden Int

  etiqueta String

  /**
   * Puntos de este nivel dentro de su criterio (0..criterio.peso).
   */
  puntos Decimal @default(0) @db.Decimal(6, 2)

  descripcion String?

  criterio RubricaCriterio @relation(fields: [criterioId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  calificaciones CriterioCalificacionEntrega[]

  @@unique([criterioId, orden])
  @@index([criterioId])
}

/**
 * Evaluación con rúbrica de una entrega. Una entrega tiene una única
 * evaluación por rúbrica; en tareas grupales la nota resultante se
 * propaga a sus integrantes y los ajustes individuales se aplican
 * después, igual que en la calificación clásica.
 */
model CalificacionRubrica {
  id Int @id @default(autoincrement())

  entregaId Int

  completada Boolean @default(false)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  entrega EntregaTarea @relation(fields: [entregaId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  items CriterioCalificacionEntrega[]

  @@unique([entregaId])
  @@index([entregaId])
}

model CriterioCalificacionEntrega {
  id Int @id @default(autoincrement())

  calificacionId Int
  criterioId     Int

  /**
   * Nivel seleccionado. Si es null, el criterio aún no se evalúa.
   */
  nivelId Int?

  /**
   * Puntos otorgados; normalmente coincide con nivel.puntos pero
   * admite ajuste fino cuando el docente así lo decide.
   */
  puntosAsignados Decimal @default(0) @db.Decimal(6, 2)

  retroalimentacion String?

  calificacion CalificacionRubrica @relation(fields: [calificacionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  criterio RubricaCriterio @relation(fields: [criterioId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  nivel RubricaNivel? @relation(fields: [nivelId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([calificacionId, criterioId])
  @@index([criterioId])
}

model EntregaTarea {
  id Int @id @default(autoincrement())

  tareaId        Int
  autorEntregaId Int

  /**
   * INDIVIDUAL:
