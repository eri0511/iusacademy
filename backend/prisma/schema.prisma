  equipoAfinidadTarea EquipoAfinidadTarea? @relation(fields: [equipoAfinidadTareaId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  archivos ArchivoAdjunto[]

  calificaciones      CalificacionEstudiante[]
