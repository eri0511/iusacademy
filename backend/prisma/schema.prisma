model ActividadCalificable {
  id Int @id @default(autoincrement())

  cursoId   Int
  hitoId    Int?
  creadorId Int

  foroId  Int? @unique
  tareaId Int? @unique
  quizId  Int? @unique

  origen TipoOrigenActividad

  /**
   * Toda actividad pertenece a Continua o Procesual.
   * Para Foro será obligatorio elegir el hito y el componente.
   */
  componente ComponenteEvaluacion

  titulo      String
  descripcion String?

  /**
   * Las actividades se califican sobre 100.
   * Se mantiene como campo para permitir validación y trazabilidad,
   * aunque la primera versión utilizará siempre 100.
   */
  puntajeMaximo Decimal @default(100) @db.Decimal(6, 2)

  /**
   * Por defecto todas las actividades válidas entran con el mismo
   * peso en el promedio del componente.
   * Si una actividad se anula o es solamente práctica, puede
   * excluirse sin eliminar sus calificaciones.
   */
  participaEnPromedio Boolean @default(true)

  /**
   * Permite ordenar las actividades en el libro de calificaciones.
   * No representa una ponderación.
   */
  orden Int @default(0)

  estado EstadoActividadCalificable @default(BORRADOR)

  visibleParaEstudiantes Boolean @default(false)

  publicadaEn DateTime?
  cerradaEn   DateTime?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  curso Curso @relation(fields: [cursoId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  hito HitoAcademico? @relation(fields: [hitoId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  creador Usuario @relation("ActividadesCalificablesCreador", fields: [creadorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  foro TemaForoCurso? @relation(fields: [foroId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  tarea TareaCurso? @relation(fields: [tareaId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  quiz QuizCurso? @relation(fields: [quizId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  rubrica RubricaEvaluacion?

  calificaciones CalificacionEstudiante[]

  historial HistorialCalificacion[]

  @@index([cursoId])
  @@index([hitoId])
  @@index([creadorId])
  @@index([origen])
  @@index([tareaId])
  @@index([quizId])
  @@index([componente])
  @@index([estado])
  @@index([participaEnPromedio])
  @@index([visibleParaEstudiantes])
  @@index([orden])
  @@index([cursoId, estado])
  @@index([cursoId, hitoId, componente])
  @@index([cursoId, hitoId, componente, participaEnPromedio])
}

