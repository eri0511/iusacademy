   */
  estudianteId Int?

  grupoCursoId          Int?
  equipoAfinidadTareaId Int?

  contenido String?

  estado EstadoEntregaTarea @default(BORRADOR)

  esGrupal Boolean @default(false)

  entregadaTarde Boolean @default(false)
  minutosRetraso Int     @default(0)

  descuentoCalculado Decimal @default(0) @db.Decimal(6, 2)

  enviadaEn   DateTime?
  editadaEn   DateTime?
