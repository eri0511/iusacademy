  actualizadoEn DateTime @updatedAt

  curso Curso @relation(fields: [cursoId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  autor Usuario @relation("TareasAutor", fields: [autorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  hito HitoAcademico @relation(fields: [hitoId], references: [id], onDelete: Restrict, onUpdate: Cascade)

