  autor Usuario @relation("TemasForoAutor", fields: [autorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  hito HitoAcademico? @relation(fields: [hitoId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  conjuntoGrupo ConjuntoGrupoCurso? @relation(fields: [conjuntoGrupoId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  respuestas RespuestaForoCurso[]

  equiposAfinidad EquipoAfinidadForo[]

  archivos ArchivoAdjunto[]

  actividadCalificable ActividadCalificable?

  historial HistorialForoCurso[]

