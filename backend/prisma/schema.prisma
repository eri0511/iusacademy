/**
 * Recurso académico contenedor.
 * Un recurso agrupa varios archivos y/o enlaces bajo un mismo tema.
 */
model RecursoCurso {
  id Int @id @default(autoincrement())

  cursoId Int
  autorId Int
  hitoId  Int?

  titulo      String
  descripcion String?

  categoria CategoriaRecursoCurso @default(MATERIAL_COMPLEMENTARIO)
  alcance   AlcanceRecursoCurso   @default(HITO)

  /**
   * Define si el recurso se utilizará únicamente en el aula,
   * en el aula y también como fuente para Quizzes,
   * o exclusivamente como fuente privada para Quizzes.
   */
  uso UsoRecursoCurso @default(AULA)

  /**
   * Controla si el recurso se muestra actualmente al estudiante.
   * Para uso = SOLO_QUIZZES, el backend debe mantener este valor en false.
   * Para AULA y AULA_Y_QUIZZES puede activarse o desactivarse sin
   * cambiar la finalidad principal del recurso.
   */
  visibleParaEstudiantes Boolean @default(true)

  estado     EstadoRecursoCurso @default(ACTIVO)
  estaActivo Boolean            @default(true)

  publicadoEn DateTime?
  archivadoEn DateTime?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  curso Curso          @relation(fields: [cursoId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  autor Usuario        @relation("RecursosCursoAutor", fields: [autorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  hito  HitoAcademico? @relation(fields: [hitoId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  contenidos RecursoContenido[]

  @@index([cursoId])
  @@index([autorId])
  @@index([hitoId])
  @@index([categoria])
  @@index([alcance])
  @@index([uso])
  @@index([estado])
  @@index([estaActivo])
  @@index([visibleParaEstudiantes])
  @@index([cursoId, alcance, estado, estaActivo])
  @@index([cursoId, hitoId, estado, estaActivo])
  @@index([cursoId, categoria, estado, estaActivo])
  @@index([cursoId, uso, estado, estaActivo])
}

/**
 * Elemento individual dentro de un recurso.
 * Puede ser un archivo versionado o un enlace externo.
 */
model RecursoContenido {
  id Int @id @default(autoincrement())

  recursoId Int

  tipo TipoContenidoRecurso

  titulo      String
  descripcion String?
  urlExterna  String?

  orden Int @default(0)

  /**
   * Solo aplica a contenidos ARCHIVO cuyo archivo vigente sea PDF.
   */
  disponibleParaQuiz Boolean @default(false)

  estaActivo  Boolean   @default(true)
  eliminadoEn DateTime?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  recurso RecursoCurso @relation(fields: [recursoId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  versiones RecursoContenidoVersion[]

  @@index([recursoId])
  @@index([tipo])
  @@index([orden])
  @@index([disponibleParaQuiz])
  @@index([estaActivo])
  @@index([recursoId, estaActivo, orden])
  @@index([recursoId, disponibleParaQuiz, estaActivo])
}

/**
 * Historial de versiones de un contenido tipo ARCHIVO.
 * Reemplazar un archivo crea una nueva versión sin eliminar la anterior.
 */
model RecursoContenidoVersion {
  id Int @id @default(autoincrement())

  contenidoId Int
  archivoId   Int @unique

  numeroVersion Int
  estado        EstadoVersionRecurso @default(VIGENTE)

  motivoActualizacion String?
  fechaDocumento      DateTime?

  esVigente     Boolean   @default(true)
  reemplazadaEn DateTime?

  estadoDataset      EstadoProcesamientoDataset @default(NO_APLICA)
  progresoDataset    Int                        @default(0)
  errorDataset       String?
  procesadoDatasetEn DateTime?
  intentosDataset    Int                        @default(0)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  contenido RecursoContenido @relation(fields: [contenidoId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  archivo   ArchivoAdjunto   @relation(fields: [archivoId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  fuentesQuiz FuenteQuiz[]

  @@unique([contenidoId, numeroVersion])
  @@index([contenidoId])
  @@index([archivoId])
  @@index([estado])
  @@index([esVigente])
  @@index([creadoEn])
  @@index([contenidoId, estado, esVigente])
  @@index([estadoDataset])
  @@index([estadoDataset, esVigente])
}

model ArchivoAdjunto {
  id Int @id @default(autoincrement())

  cursoId     Int?
  subidoPorId Int

  temaForoId       Int?
  respuestaForoId  Int?
  comentarioForoId Int?
  tareaId          Int?
  entregaTareaId   Int?

  categoria CategoriaArchivoAdjunto

  nombreOriginal   String
  nombreAlmacenado String
  ruta             String
  urlPublica       String?

  mimeType  String
  extension String

  tamanioBytes Int

  hashSha256 String?

  esTemporal      Boolean   @default(false)
  fechaExpiracion DateTime?

  esAnalizadoIA Boolean @default(false)
  textoExtraido String?
  miniaturaUrl  String?

  cantidadDescargas Int @default(0)
  numeroVersion     Int @default(1)

  descripcion String?

  permiteDescarga Boolean @default(true)
  estaActivo      Boolean @default(true)

  eliminadoEn DateTime?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  curso Curso? @relation(fields: [cursoId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  subidoPor Usuario @relation("ArchivosSubidosPor", fields: [subidoPorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  temaForo TemaForoCurso? @relation(fields: [temaForoId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  respuestaForo RespuestaForoCurso? @relation(fields: [respuestaForoId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  comentarioForo ComentarioRespuestaForo? @relation(fields: [comentarioForoId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  tarea TareaCurso? @relation(fields: [tareaId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  entregaTarea EntregaTarea? @relation(fields: [entregaTareaId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  versionContenidoRecurso RecursoContenidoVersion?

  @@index([cursoId])
  @@index([subidoPorId])
  @@index([temaForoId])
  @@index([respuestaForoId])
  @@index([comentarioForoId])
  @@index([tareaId])
  @@index([entregaTareaId])
  @@index([categoria])
  @@index([hashSha256])
  @@index([esTemporal, fechaExpiracion])
  @@index([esAnalizadoIA])
  @@index([estaActivo])
  @@index([creadoEn])
}

model HistorialForoCurso {
  id Int @id @default(autoincrement())

  temaId Int

  respuestaId  Int?
  comentarioId Int?
  equipoId     Int?

  actorId Int

  accion AccionHistorialForo

  detalle Json?

  registradoEn DateTime @default(now())

  tema TemaForoCurso @relation(fields: [temaId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  respuesta RespuestaForoCurso? @relation(fields: [respuestaId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  comentario ComentarioRespuestaForo? @relation(fields: [comentarioId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  equipo EquipoAfinidadForo? @relation(fields: [equipoId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  actor Usuario @relation("HistorialForoActor", fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([temaId])
  @@index([respuestaId])
  @@index([comentarioId])
  @@index([equipoId])
  @@index([actorId])
  @@index([accion])
  @@index([registradoEn])
  @@index([temaId, registradoEn])
}

model HistorialCalificacion {
  id Int @id @default(autoincrement())

  actividadId    Int
  calificacionId Int?

  actorId Int

  accion AccionHistorialCalificacion

  detalle Json?

  registradoEn DateTime @default(now())

  actividad ActividadCalificable @relation(fields: [actividadId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  calificacion CalificacionEstudiante? @relation(fields: [calificacionId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  actor Usuario @relation("HistorialCalificacionActor", fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([actividadId])
  @@index([calificacionId])
  @@index([actorId])
  @@index([accion])
  @@index([registradoEn])
  @@index([actividadId, registradoEn])
}

model ReporteEmitido {
  id String @id @default(uuid())

  codigo            String  @unique
  tipo              String
  titulo            String
  formato           String
  nombreArchivo     String?
  mimeType          String?
  cantidadRegistros Int     @default(0)
  filtros           Json?
  hashSha256        String?

  estado EstadoReporteEmitido @default(GENERANDO)

  generadoPorId   Int
  generadoEn      DateTime  @default(now())
  finalizadoEn    DateTime?
  expiraEn        DateTime?
  anuladoEn       DateTime?
  anuladoPorId    Int?
  motivoAnulacion String?
  errorGeneracion String?

  generadoPor Usuario  @relation("ReportesGenerados", fields: [generadoPorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  anuladoPor  Usuario? @relation("ReportesAnulados", fields: [anuladoPorId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([codigo])
  @@index([estado])
  @@index([generadoPorId])
  @@index([generadoEn])
  @@index([tipo, formato])
}

/**
 * Notificaciones dirigidas a un usuario. Alimenta la campana en la web
 * y el mecanismo de empuje hacia la futura app móvil.
 */
model Notificacion {
  id Int @id @default(autoincrement())

  destinatarioId Int

  tipo TipoNotificacion

  titulo String
  cuerpo String?

  /**
   * Ruta interna del frontend adonde llevar al usuario al tocar la notificación
   * (ej: `/docente/cursos/12/tareas/34`).
   */
  enlace String?

  esLeida Boolean   @default(false)
  leidaEn DateTime?

  creadoEn DateTime @default(now())

  destinatario Usuario @relation("NotificacionesDestinatario", fields: [destinatarioId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([destinatarioId, esLeida, creadoEn])
  @@index([destinatarioId, tipo])
  @@index([creadoEn])
}

/**
 * Configuración y estado de una jornada de exposiciones asociada a una tarea.
 * Una tarea puede tener varias jornadas para soportar exposiciones en fechas distintas.
 */
model JornadaExposicion {
  id Int @id @default(autoincrement())

  tareaId   Int
  creadorId Int

  metodoOrden MetodoOrdenExposicion
  estado      EstadoJornadaExposicion @default(CONFIGURANDO)

  duracionSegundos Int
  avisoSegundos    Int @default(120)

  permitirTiempoExtra Boolean @default(true)
  mostrarSiguiente    Boolean @default(true)

  generadaEn   DateTime?
  iniciadaEn   DateTime?
  finalizadaEn DateTime?
  canceladaEn  DateTime?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  tarea   TareaCurso @relation(fields: [tareaId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  creador Usuario    @relation("JornadasExposicionCreador", fields: [creadorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  turnos TurnoExposicion[]

  @@index([tareaId])
  @@index([creadorId])
  @@index([estado])
  @@index([tareaId, estado])
}

model TurnoExposicion {
  id Int @id @default(autoincrement())

  jornadaId Int
  entregaId Int

  presentadorId Int?

  orden  Int
  estado EstadoTurnoExposicion @default(PENDIENTE)

  iniciadoEn   DateTime?
  pausadoEn    DateTime?
  reanudadoEn  DateTime?
  finalizadoEn DateTime?

  segundosPausaAcumulados Int @default(0)
  segundosUtilizados      Int @default(0)

  diapositivaActual Int @default(1)

  observacionDocente String?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  jornada     JornadaExposicion @relation(fields: [jornadaId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  entrega     EntregaTarea      @relation(fields: [entregaId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  presentador Usuario?          @relation("TurnosExposicionPresentador", fields: [presentadorId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  preguntas PreguntaExposicion[]

  analisis AnalisisExposicion?

  @@unique([jornadaId, entregaId])
  @@unique([jornadaId, orden])
  @@index([jornadaId])
  @@index([entregaId])
  @@index([presentadorId])
  @@index([estado])
  @@index([jornadaId, estado])
}

/**
 * Resultado persistente del análisis inteligente de una exposición.
 * No participa en el cálculo de CalificacionEstudiante ni modifica la rúbrica.
 */
model AnalisisExposicion {
  id Int @id @default(autoincrement())

  turnoId       Int @unique
  generadoPorId Int

  estado EstadoAnalisisExposicion @default(PENDIENTE)

  /**
   * Permite regenerar el análisis conservando trazabilidad de la versión actual.
   */
  version Int @default(1)

  motor String @default("IUSACADEMY_ANALISIS_V1")

  puntuacionEstructura        Decimal? @db.Decimal(5, 2)
  puntuacionContenidoJuridico Decimal? @db.Decimal(5, 2)
  puntuacionPresentacion      Decimal? @db.Decimal(5, 2)
  puntuacionGlobal            Decimal? @db.Decimal(5, 2)

  resumen String?

  fortalezas   String[] @default([])
  advertencias String[] @default([])
  omisiones    String[] @default([])

  retroalimentacionSugerida String?

  /**
   * Evidencias y métricas utilizadas por el motor: archivos, cantidad de
   * palabras, preguntas, duración, estructura guiada, etc.
   */
  evidencias Json?

  /**
   * Huella de la entrada utilizada para detectar cambios entre regeneraciones.
   */
  hashEntrada String?

  error String?

  iniciadoEn   DateTime?
  finalizadoEn DateTime?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  turno TurnoExposicion @relation(fields: [turnoId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  generadoPor Usuario @relation("AnalisisExposicionGenerador", fields: [generadoPorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([generadoPorId])
  @@index([estado])
  @@index([finalizadoEn])
}

model PreguntaExposicion {
  id Int @id @default(autoincrement())

  turnoId Int
  autorId Int

  contenido String
  estado    EstadoPreguntaExposicion @default(PENDIENTE)

  /**
   * Contexto exacto en el que se realizó la pregunta.
   * Se captura desde el turno activo en el servidor para que el estudiante
   * no pueda alterar manualmente la diapositiva o el instante de la exposición.
   */
  diapositiva        Int?
  segundosExposicion Int?

  destacada Boolean @default(false)

  respondidaEn DateTime?
  descartadaEn DateTime?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  turno TurnoExposicion @relation(fields: [turnoId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  autor Usuario         @relation("PreguntasExposicionAutor", fields: [autorId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  votos VotoPreguntaExposicion[]

  @@index([turnoId])
  @@index([autorId])
  @@index([estado])
  @@index([turnoId, estado, creadoEn])
}

model VotoPreguntaExposicion {
  id Int @id @default(autoincrement())

  preguntaId Int
  usuarioId  Int

  creadoEn DateTime @default(now())

  pregunta PreguntaExposicion @relation(fields: [preguntaId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  usuario  Usuario            @relation("VotosPreguntaExposicionUsuario", fields: [usuarioId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([preguntaId, usuarioId])
  @@index([preguntaId])
  @@index([usuarioId])
}

/**
 * Extensión de plazo aplicada a una tarea para un conjunto de estudiantes.
 * Permite que un docente amplíe individualmente (o por grupo/equipo) las
 * fechas de una tarea sin alterar los plazos globales de la misma.
 * Se modela la extensión como un registro por tarea con una lista de
 * beneficiarios, de modo que la misma extensión pueda cubrir varios
 * estudiantes a la vez.
 */
model ExtensionPlazoTarea {
  id Int @id @default(autoincrement())

  tareaId         Int
  autorizadoPorId Int

  fechaAperturaExtendida      DateTime?
  fechaLimiteExtendida        DateTime?
  fechaMaximaRetrasoExtendida DateTime?

  motivo String?

  activo Boolean @default(true)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  tarea         TareaCurso @relation(fields: [tareaId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  autorizadoPor Usuario    @relation("ExtensionesPlazoAutorizadas", fields: [autorizadoPorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  beneficiarios ExtensionPlazoBeneficiario[]

  @@index([tareaId])
  @@index([autorizadoPorId])
  @@index([activo])
}

model ExtensionPlazoBeneficiario {
  id Int @id @default(autoincrement())

  extensionId  Int
  estudianteId Int

  extension  ExtensionPlazoTarea @relation(fields: [extensionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  estudiante Usuario             @relation("ExtensionesPlazoBeneficiario", fields: [estudianteId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([extensionId, estudianteId])
  @@index([estudianteId])
}

enum CategoriaBiblioteca {
  MEMORIAL
  CONTRATO
  DEMANDA
  JURISPRUDENCIA
  CODIGO
  LEY
  SENTENCIA
  DOCTRINA
  GUIA
  CASO_PRACTICO
  OTRO
}

enum EstadoRecursoBiblioteca {
  BORRADOR
  PUBLICADO
  ARCHIVADO
}

enum VigenciaBiblioteca {
  NO_APLICA
  POR_VERIFICAR
  VIGENTE
  MODIFICADA
  DEROGADA
}

enum TipoContenidoBiblioteca {
  ARCHIVO
  ENLACE
}

enum EstadoReporteBiblioteca {
  PENDIENTE
  EN_REVISION
  RESUELTO
  DESCARTADO
}

model RecursoBiblioteca {
  id                   Int                          @id @default(autoincrement())
  titulo               String
  descripcion          String
  finalidad            String?
  categoria            CategoriaBiblioteca
  tema                 String
  etiquetas            String[]                     @default([])
  autorInstitucion     String?
  fuente               String?
  fechaDocumento       DateTime?
  numeroNorma          String?
  tribunal             String?
  numeroResolucion     String?
  vigencia             VigenciaBiblioteca           @default(NO_APLICA)
  vigenciaVerificadaEn DateTime?
  observacionVigencia  String?
  destacado            Boolean                      @default(false)
  estado               EstadoRecursoBiblioteca      @default(BORRADOR)
  publicadoEn          DateTime?
  archivadoEn          DateTime?
  creadoPorId          Int
  creadoEn             DateTime                     @default(now())
  actualizadoEn        DateTime                     @updatedAt
  creadoPor            Usuario                      @relation("BibliotecaAutor", fields: [creadoPorId], references: [id], onDelete: Restrict)
  contenidos           ContenidoBiblioteca[]
  favoritos            FavoritoBiblioteca[]
  colecciones          ColeccionRecursoBiblioteca[]
  reportes             ReporteRecursoBiblioteca[]
  historial            HistorialBiblioteca[]
  relacionesOrigen     RelacionRecursoBiblioteca[]  @relation("BibliotecaOrigen")
  relacionesDestino    RelacionRecursoBiblioteca[]  @relation("BibliotecaDestino")

  @@index([estado, categoria])
  @@index([estado, tema])
  @@index([estado, destacado, actualizadoEn])
  @@index([creadoPorId])
}

model ContenidoBiblioteca {
  id            Int                          @id @default(autoincrement())
  recursoId     Int
  titulo        String
  tipo          TipoContenidoBiblioteca
  urlExterna    String?
  orden         Int                          @default(0)
  estaActivo    Boolean                      @default(true)
  creadoEn      DateTime                     @default(now())
  actualizadoEn DateTime                     @updatedAt
  recurso       RecursoBiblioteca            @relation(fields: [recursoId], references: [id], onDelete: Restrict)
  versiones     VersionContenidoBiblioteca[]

  @@index([recursoId, estaActivo, orden])
}

model VersionContenidoBiblioteca {
  esVigente           Boolean             @default(true)
  id                  Int                 @id @default(autoincrement())
  contenidoId         Int
  numeroVersion       Int
  nombreOriginal      String
  nombreAlmacenado    String
  ruta                String
  mimeType            String
  extension           String
  tamanioBytes        Int
  hashSha256          String
  motivoActualizacion String?
  subidoPorId         Int
  cantidadDescargas   Int                 @default(0)
  creadoEn            DateTime            @default(now())
  contenido           ContenidoBiblioteca @relation(fields: [contenidoId], references: [id], onDelete: Restrict)
  subidoPor           Usuario             @relation("BibliotecaVersionAutor", fields: [subidoPorId], references: [id], onDelete: Restrict)

  @@unique([contenidoId, numeroVersion])
  @@index([hashSha256])
  @@index([subidoPorId])
}

model PermisoGestionBiblioteca {
  id            Int       @id @default(autoincrement())
  docenteId     Int       @unique
  otorgadoPorId Int
  revocadoPorId Int?
  estaActivo    Boolean   @default(true)
  otorgadoEn    DateTime  @default(now())
  revocadoEn    DateTime?
  docente       Usuario   @relation("BibliotecaDocentePermiso", fields: [docenteId], references: [id], onDelete: Restrict)
  otorgadoPor   Usuario   @relation("BibliotecaOtorgaPermiso", fields: [otorgadoPorId], references: [id], onDelete: Restrict)
  revocadoPor   Usuario?  @relation("BibliotecaRevocaPermiso", fields: [revocadoPorId], references: [id], onDelete: Restrict)

  @@index([estaActivo])
}

model FavoritoBiblioteca {
  usuarioId Int
  recursoId Int
  creadoEn  DateTime          @default(now())
  usuario   Usuario           @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  recurso   RecursoBiblioteca @relation(fields: [recursoId], references: [id], onDelete: Restrict)

  @@id([usuarioId, recursoId])
  @@index([recursoId])
}

model ColeccionBiblioteca {
  id            Int                          @id @default(autoincrement())
  usuarioId     Int
  nombre        String
  descripcion   String?
  creadoEn      DateTime                     @default(now())
  actualizadoEn DateTime                     @updatedAt
  usuario       Usuario                      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  recursos      ColeccionRecursoBiblioteca[]

  @@unique([usuarioId, nombre])
}

model ColeccionRecursoBiblioteca {
  coleccionId Int
  recursoId   Int
  agregadoEn  DateTime            @default(now())
  coleccion   ColeccionBiblioteca @relation(fields: [coleccionId], references: [id], onDelete: Cascade)
  recurso     RecursoBiblioteca   @relation(fields: [recursoId], references: [id], onDelete: Restrict)

  @@id([coleccionId, recursoId])
  @@index([recursoId])
}

model RelacionRecursoBiblioteca {
  origenId  Int
  destinoId Int
  origen    RecursoBiblioteca @relation("BibliotecaOrigen", fields: [origenId], references: [id], onDelete: Cascade)
  destino   RecursoBiblioteca @relation("BibliotecaDestino", fields: [destinoId], references: [id], onDelete: Cascade)

  @@id([origenId, destinoId])
  @@index([destinoId])
}

model ReporteRecursoBiblioteca {
  id            Int                     @id @default(autoincrement())
  recursoId     Int
  usuarioId     Int
  motivo        String
  estado        EstadoReporteBiblioteca @default(PENDIENTE)
  respuesta     String?
  atendidoPorId Int?
  atendidoEn    DateTime?
  creadoEn      DateTime                @default(now())
  recurso       RecursoBiblioteca       @relation(fields: [recursoId], references: [id], onDelete: Restrict)
  usuario       Usuario                 @relation("BibliotecaReportante", fields: [usuarioId], references: [id], onDelete: Restrict)
  atendidoPor   Usuario?                @relation("BibliotecaAtiendeReporte", fields: [atendidoPorId], references: [id], onDelete: Restrict)

  @@index([estado, creadoEn])
  @@index([recursoId])
}

model HistorialBiblioteca {
  id        Int                @id @default(autoincrement())
  recursoId Int?
  actorId   Int
  accion    String
  datos     Json?
  creadoEn  DateTime           @default(now())
  recurso   RecursoBiblioteca? @relation(fields: [recursoId], references: [id], onDelete: Restrict)
  actor     Usuario            @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([recursoId, creadoEn])
  @@index([actorId])
}
