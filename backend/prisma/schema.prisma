model CalificacionEstudiante {
  id Int @id @default(autoincrement())

  actividadId  Int
  estudianteId Int

  calificadorId Int?

  respuestaForoId  Int?
  grupoCursoId     Int?
  equipoAfinidadId Int?
  entregaTareaId   Int?
  intentoQuizId    Int? @unique

  /**
   * Todas estas notas permanecen internamente sobre 100.
   * notaBase:
   * Nota académica antes de descuentos o ajustes.
   * descuentoRetraso:
   * Descuento calculado por entrega tardía sobre la escala de 100.
   * descuentoComentarios:
   * Penalización individual por incumplir comentarios mínimos.
   * No se aplica al representante.
   * ajusteIndividual:
   * Ajuste positivo o negativo sobre la escala de 100.
   * notaFinal:
   * Resultado definitivo de esta actividad sobre 100.
   * La conversión institucional a /15 o /10 NO se guarda aquí:
   * se calcula desde el promedio de todas las actividades válidas
   * del mismo hito y componente.
   */
  notaBase         Decimal @default(0) @db.Decimal(6, 2)
  descuentoRetraso Decimal @default(0) @db.Decimal(6, 2)

  /**
   * Descuento individual por incumplir la participación mediante comentarios.
   * El representante del equipo siempre debe conservar 0 en este campo.
   */
  descuentoComentarios Decimal @default(0) @db.Decimal(6, 2)

  ajusteIndividual Decimal @default(0) @db.Decimal(6, 2)
  notaFinal        Decimal @default(0) @db.Decimal(6, 2)

  retroalimentacion String?

  estado EstadoCalificacion @default(PENDIENTE)

  calificadaEn DateTime?
  publicadaEn  DateTime?
  anuladaEn    DateTime?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  actividad ActividadCalificable @relation(fields: [actividadId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  estudiante Usuario @relation("CalificacionesEstudiante", fields: [estudianteId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  calificador Usuario? @relation("CalificacionesCalificador", fields: [calificadorId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  respuestaForo RespuestaForoCurso? @relation(fields: [respuestaForoId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  grupoCurso GrupoCurso? @relation(fields: [grupoCursoId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  equipoAfinidad EquipoAfinidadForo? @relation(fields: [equipoAfinidadId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  entregaTarea EntregaTarea? @relation(fields: [entregaTareaId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  intentoQuiz IntentoQuiz? @relation(fields: [intentoQuizId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  evaluacionesCriterios EvaluacionCriterioRubrica[]

  historial HistorialCalificacion[]

  @@unique([actividadId, estudianteId])
  @@index([actividadId])
  @@index([estudianteId])
  @@index([calificadorId])
  @@index([respuestaForoId])
  @@index([grupoCursoId])
  @@index([equipoAfinidadId])
  @@index([intentoQuizId])
  @@index([estado])
  @@index([actividadId, estado])
}

