  @@index([creadorId])
  @@index([estado])
  @@index([modalidad])
  @@index([dificultad])
  @@index([esCalificable])
  @@index([componente])
  @@index([cursoId, hitoId])
  @@index([cursoId, estado])
  @@index([cursoId, modalidad, estado])
