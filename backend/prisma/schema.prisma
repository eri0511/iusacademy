  jornadasExposicion JornadaExposicion[]

  @@index([cursoId])
  @@index([autorId])
  @@index([hitoId])
  @@index([conjuntoGrupoId])
  @@index([estado])
  @@index([tipo])
  @@index([modoEdicion])
  @@index([modalidad])
  @@index([origenGrupo])
  @@index([esCalificable])
  @@index([fechaApertura])
  @@index([fechaLimite])
  @@index([fechaCierre])
  @@index([estaActiva])
  @@index([cursoId, hitoId, estado, estaActiva])
}

model ComponenteTarea {
