/**
 * Define la experiencia académica principal de la tarea.
 * Las capacidades concretas se guardan aparte para permitir que
 * experiencias como REDACCION_JURIDICA también sean colaborativas.
 */
enum TipoTarea {
  ENTREGA_ARCHIVOS
  RESPUESTA_ESCRITA
  DOCUMENTO_COLABORATIVO
  REDACCION_JURIDICA
  EXPOSICION
  CASO_PRACTICO
  MIXTA
  PRESENCIAL
}

/**
 * Capacidades reutilizables de una tarea. No equivalen al tipo.
 * Por ejemplo REDACCION_JURIDICA puede habilitar EDICION_COLABORATIVA,
 * SEGUIMIENTO_AUTORIA, HISTORIAL_VERSIONES y EXPORTACION_PDF.
 */
enum CapacidadTarea {
  ARCHIVOS
  EDITOR_TEXTO
  EDICION_COLABORATIVA
  SEGUIMIENTO_AUTORIA
  HISTORIAL_VERSIONES
  EXPORTACION_PDF
  EXPOSICION
  CASO_ESTRUCTURADO
  REDACCION_JURIDICA
  EVIDENCIA_DOCENTE
}

enum ModoEdicionTarea {
  SIN_EDITOR
  INDIVIDUAL
  COLABORATIVO
}

/**
 * Origen de la rúbrica de evaluación. Cuando se importa desde Excel,
